# Key shown in class (MAPID basemap). No quotes, no spaces around =.
VITE_MAPID_KEY=

# Optional. Where point tiles come from.
#   empty  -> dev: http://127.0.0.1:8080 (tiles/server.py), build: static files in public/tiles
#   static -> always use public/tiles (run scripts/export_tiles.py first)
#   a URL  -> any tile server, e.g. https://tiles.example.com/suppliers/{z}/{x}/{y}.mvt
VITE_MVT_TILES=
